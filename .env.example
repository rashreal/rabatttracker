DB_PATH=data/rabatttracker.db

# Only needed if migrations are stored somewhere other than the default
# relative path (see Dockerfile). Usually leave unset.
# MIGRATIONS_PATH=src/lib/server/db/migrations

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# No Marktguru API key config needed - the app fetches its (unofficial,
# rotating) auth keys directly from marktguru.de at request time. See README
# for details and the associated operational risk.
